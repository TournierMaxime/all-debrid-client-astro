---
const { tag, color = "", clx = "" } = Astro.props
---

<button
  title={tag}
  class={`bg-[var(--ads-bg-default)] text-left text-[var(--ads-text-black)] text-sm font-normal px-2 py-1 m-1 rounded border border-[var(--ads-border-dropdown)] truncate ${color} ${clx ? clx : "w-auto"}`}
>
  {tag}
</button>
