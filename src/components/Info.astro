---
import Tag from "./Tag.astro"

interface Props {
  title?: string
  subtitle?: string
  data?: string | number
  dataMap?: { tag: string }[]
}

const { title, subtitle, data, dataMap } = Astro.props

const hasDataMap = Array.isArray(dataMap) && dataMap.length > 0
---

{title ? <h3 class="font-semibold text-normal ml-2">{title}</h3> : null}
{subtitle ? <h5 class="font-semibold text-sm ml-2">{subtitle}</h5> : null}

{
  hasDataMap && (
    <ul class="ml-2 flex flex-row flex-wrap">
      {dataMap.map((d) => (
        <li>
          <Tag tag={d.tag} />
        </li>
      ))}
    </ul>
  )
}

{!hasDataMap && !data && <Tag clx="ml-2" tag="Non" />}

{data && <Tag clx="ml-2" tag={data} />}
