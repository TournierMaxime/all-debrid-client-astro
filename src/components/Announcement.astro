---
import { AlertMessage } from "./Alert"

const title = "Information"
const description =
  "Un grand nombre de liens ne sont plus accessible via l'api alldebrid. Une alternative est en cours de développement. En attendant il est préférable d'utiliser l'ancienne méthode en passant par zone-annuaire."
---

<div class="bg-(--ads-bg-default) p-4">
  <AlertMessage title={title} description={description} />
</div>
