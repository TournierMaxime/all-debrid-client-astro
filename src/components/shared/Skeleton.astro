---
import { Card, CardContent, CardHeader } from "@/components/ui/card"
import { Skeleton as SkeletonShadcn } from "@/components/ui/skeleton"
---

<Card className="w-full max-w-xs bg-transparent">
  <CardHeader className="bg-transparent">
    <SkeletonShadcn className="h-4 w-2/3" />
    <SkeletonShadcn className="h-4 w-1/2" />
  </CardHeader>
  <CardContent className="bg-transparent">
    <SkeletonShadcn className="aspect-video w-full" />
  </CardContent>
</Card>
