---
import Tag from "./Tag.astro"

const { time, isMovie } = Astro.props

if (!time) return null
if (time === 0) return

let hours, minutes
if (isMovie) {
  hours = Math.floor(time / 60)
  minutes = time % 60
} else {
  hours = Math.floor(time / 60)
  minutes = time % 60
}

const hasHours = hours > 0
---

<>
  {
    isMovie ? (
      <Tag tag={`${hasHours ? hours + "H" : ""}${minutes}Min`} />
    ) : (
      <Tag tag={`${hasHours ? hours + "H" : ""}${minutes}Min / ep`} />
    )
  }
</>
