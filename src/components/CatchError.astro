---
import { AlertMessage } from "@/components/Alert"
const { error } = Astro.props as { error: string }
---

<div class="bg-(--ads-bg-default) p-2">
  <AlertMessage
    title={error}
    backgroundColor="bg-(--ads-error-bg-default)"
    borderColor="border-(--ads-error-border-default)"
    color="text-(--ads-error-text-default)"
  />
</div>
