---
import moment from "moment"
import app from "../../../package.json"
import Domain from "../shared/Domain.astro"

import { zaService } from "@/services/za"

const { domainName } = Astro.props

const getDomainName = await zaService.checkDomainName()

if (!getDomainName) return

const { name } = getDomainName.domain

const { version } = app
---

<footer
  class="flex flex-col items-center p-4 bg-white border-t-2 border-slate-200"
>
  <span class="font-normal text-sm"
    >AllDebrid Scraper - {moment().format("YYYY")}</span
  >
  <span class="font-normal text-sm">Version {version}</span>
  <Domain domainName={name} />
</footer>
