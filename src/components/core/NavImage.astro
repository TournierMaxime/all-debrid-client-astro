---
import logo from "../../../public/logo.png"
import { Image } from "astro:assets"
---

<div class="w-2/12 flex flex-row items-center">
  <a href={"/"}>
    <Image
      src={logo}
      alt="All Debrid Scraper"
      width={500}
      height={500}
      class="md:w-20 md:h-20 w-15 h-15 max-w-20"
    />
  </a>
  <ul class="flex flex-col flex-wrap sm:flex-row sm:flex-nowrap">
    <li class="mr-4 my-0.5 sm:my-0">
      <a href="/history" class="font-semibold text-normal">Historique</a>
    </li>
    <li class="mr-4 my-0.5 sm:my-0">
      <a href="/libraries" class="font-semibold text-normal">Plex</a>
    </li>
    <li>
      <a href="/downloads" class="font-semibold text-normal">Téléchargements</a>
    </li>
  </ul>
</div>
