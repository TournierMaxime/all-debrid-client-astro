---
import "../styles/global.css"

import Head from "../components/Head.astro"
import Header from "../components/Header.astro"
import NavImage from "../components/NavImage.astro"
import Footer from "../components/Footer.astro"

import SearchWrapper from "../wrappers/SearchWrapper"

const { title = "All Debrid" } = Astro.props
---

<!doctype html>
<html lang="en">
  <Head title={title} />
  <body
    class="max-w-[1024px] mx-auto bg-slate-200 border border-slate-200 shadow-md rounded-md"
  >
    <Header>
      <NavImage />
      <div class="w-8/12"></div>
      <SearchWrapper client:load />
    </Header>

    <slot />

    <Footer />
  </body>
</html>
