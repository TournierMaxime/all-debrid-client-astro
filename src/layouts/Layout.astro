---
import "../styles/global.css"

import Head from "../components/Head.astro"
import Header from "../components/Header.astro"
import NavImage from "../components/NavImage.astro"
// import SearchForm from "../feature/search/components/Search.tsx"

import { FaSearch } from "react-icons/fa"

const { title = "All Debrid" } = Astro.props
---

<!doctype html>
<html lang="en">
  <Head title={title} />
  <body class="antialiased max-w-[1024px] mx-auto bg-slate-200">
    <Header>
      <NavImage />
      <div class="w-8/12"></div>
       <Fragment>
      <div class="flex flex-col justify-center items-center md:flex-row md:justify-center w-2/12">
        <div class="flex items-center" >
          <FaSearch className="sm:w-[50px] sm:h-[50px] w-[40px] h-[40px] max-w-[50px] cursor-pointer mr-4" />
        </div>

      </div>
    </Fragment>
    </Header>

    <slot />
  </body>
</html>
