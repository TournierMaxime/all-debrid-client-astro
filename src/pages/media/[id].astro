---
import Layout from "../../layouts/Layout.astro"
import Details from "../../feature/media/components/Details.astro"
import Poster from "../../feature/media/components/Poster.astro"
import Qualities from "../../feature/media/components/Qualities.astro"
import Languages from "../../feature/media/components/Languages.astro"
import Tag from "../../components/Tag.astro"

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"

import { zaService } from "../../services/za"
import { zaFullUrl } from "../../constants/utils"

import { EnumFilmSerie, type Media } from "../../feature/media/type/media"

import MediaWrapper from "../../wrappers/MediaWrapper"

export const prerender = false

const { id } = Astro.params

if (!id) {
  throw new Error("ID parameter is missing")
}

const decodeURI = decodeURIComponent(id)
const url = `${zaFullUrl}/?${decodeURI}`

let data: Media

if (id.includes("film")) {
  data = await zaService.getFilm(url)
} else if (id.includes("serie")) {
  data = await zaService.getSerie(url)
} else {
  throw new Error("Invalid ID parameter")
}
---

<Layout>
  <Card className="flex flex-col bg-[var(--ads-bg-default)] rounded-none">
    <CardHeader>
      <CardTitle> {data.title}</CardTitle>
      <CardDescription>
        <ul class="flex flex-row flex-wrap my-2">
          <li><Tag tag={data.originalTitle} /></li>
          <li><Tag tag={data.duration} /></li>
          <li><Tag tag={data.origin} /></li>
          <li><Tag tag={data.releaseDate} /></li>
        </ul>
      </CardDescription>
    </CardHeader>
    <CardContent className="flex flex-col items-center w-full h-full mx-auto">
      <div
        class="flex items-start md:flex-row md:justify-between flex-col w-full"
      >
        <Poster
          clx="w-45 h-65 md:w-60 md:h-80 sm:w-40 sm:h-60 rounded-lg"
          title={data.title}
          src={data.image}
        />
        <div class="flex flex-col w-full mb-4">
          <Details data={data} />
        </div>
      </div>

      <div class="flex md:flex-row md:justify-between flex-col w-full">
        {
          id.includes("film") ? (
            <Qualities qualities={data.qualities} />
          ) : (
            <Languages languages={data.availableLanguages} />
          )
        }

        <MediaWrapper
          client:load
          data={data}
          type={id.includes("film") ? EnumFilmSerie.film : EnumFilmSerie.serie}
        />
      </div>
    </CardContent>
  </Card>
</Layout>
