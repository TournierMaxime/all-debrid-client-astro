---
import Layout from "@/layouts/Layout.astro"
import Media from "@/feature/media/components/Media.astro"
import Loader from "@/components/shared/Loader.astro"

const { id } = Astro.params

if (!id) return
---

<Layout>
  <Media server:defer id={id}>
    <Loader slot="fallback" />
  </Media>
</Layout>
