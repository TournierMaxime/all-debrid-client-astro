---
import CatchError from "@/components/shared/CatchError.astro"
import Layout from "@/layouts/Layout.astro"
import { zaService } from "@/services/za"
import Medias from "./medias.astro"
import Loader from "@/components/shared/Loader.astro"

const query = Astro.url.searchParams.get("query")
const filter = Astro.url.searchParams.get("filter")

if (!query || !filter) {
  return Astro.redirect("/")
}

let response
try {
  response = await zaService.search({
    query,
    filter: filter as "films" | "series",
  })
} catch (e) {
  response = { message: "Une erreur technique est survenue." }
}
---

<Layout>
  {
    response && response.message ? (
      <CatchError error={response.message} />
    ) : (
      <Medias server:defer data={response}>
        <Loader slot="fallback" />
      </Medias>
    )
  }
</Layout>
