---
import CatchError from "@/components/CatchError.astro"
import Layout from "../layouts/Layout.astro"
import { zaService } from "../services/za"
import Medias from "./medias.astro"

const query = Astro.url.searchParams.get("query")
const filter = Astro.url.searchParams.get("filter")

if (!query || !filter) {
  // return Astro.redirect('/');
  throw new Error("Query and filter parameters are required")
}

const response = await zaService.search({
  query,
  filter: filter as "films" | "series",
})
---

<Layout>
  {
    response.message ? (
      <CatchError error={response.message} />
    ) : (
      <Medias data={response} />
    )
  }
</Layout>
