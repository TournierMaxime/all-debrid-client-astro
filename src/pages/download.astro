---
import Layout from "../layouts/Layout.astro"
import { nasService } from "@/services/nas"

const id = Astro.url.searchParams.get("id")

if (!id) {
  return null
}

const process = async () => {
  const create = await nasService.createDownloadTask(id, "video/Films")

  const createId = create?.data?.task_id[0]

  const pause = await nasService.pauseTask(createId)
}

await process()
---

<Layout>
  <div class="bg-(--ads-bg-default) p-4">
    <h1 class="text-2xl font-bold">Page de téléchargement</h1>
    <p>ID du téléchargement : {id}</p>
  </div>
</Layout>
