---
import Layout from "../layouts/Layout.astro"

import DownloadAgainWrapper from "../wrappers/DownloadAgainWrapper"

import { allDebridService } from "../services/za"

import moment from "moment"
import Tag from "../components/Tag.astro"
import DeleteSaveLinkWrapper from "../wrappers/DeleteSaveLinkWrapper"

import { formatBytes } from "../constants/utils"

import Button, { DeleteButton } from "../components/Button"

type History = {
  status: string
  data: {
    links: Link[]
  }
}

type Link = {
  link: string
  date: number
  host: string
  filename: string
  size: number
}

const response = await allDebridService.getUserLinks()
const { links } = response.data

const sortedLinks = links.sort((a: any, b: any) => b.date - a.date)
---

<Layout>
  <div class="flex flex-col bg-white">
    <div class="m-2">
      {
        sortedLinks.map((data: Link) => (
          <div class="flex flex-col md:flex-row md:justify-between flex-1 min-w-0 md:min-w-[250px] border border-slate-400 rounded p-4 my-2 bg-white">
            <div class="min-w-0">
              <p class="truncate">{data.filename}</p>
              <Button
                title="Télécharger"
                onClick={`window.dispatchEvent(new CustomEvent("download-again", { detail: { link: "${data.link}" } }))`}
              >
                Télécharger
              </Button>
              <DeleteButton
                title="Supprimer"
                onClick={`window.dispatchEvent(new CustomEvent("delete-link", { detail: { link: "${data.link}" } }))`}
              >
                Supprimer
              </DeleteButton>
              <Tag tag={formatBytes(data.size)} />
            </div>
            <div>
              <Tag tag={moment.unix(data.date).format("DD/MM/YYYY à HH:mm")} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <DownloadAgainWrapper client:only="react" />
  <DeleteSaveLinkWrapper client:only="react" />
</Layout>
