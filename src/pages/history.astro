---
import Layout from "../layouts/Layout.astro"

import DownloadAgainWrapper from "../wrappers/DownloadAgainWrapper"
import DownloadAgain from "../feature/media/components/Modal"

import { allDebridService } from "../services/za"

import moment from "moment"
import Tag from "../components/Tag.astro"

type History = {
  status: string
  data: {
    links: Link[]
  }
}

type Link = {
  link: string
  link_dl: string
  filename: string
  size: number
  date: number
  host: string
}

const response = await allDebridService.getUserHistory()
const { links } = response.data

const formatBytes = (bytes: number) => {
  if (bytes === 0) return "0 B"

  const k = 1024
  const sizes = ["B", "KB", "MB", "GB", "TB"]
  const i = Math.floor(Math.log(bytes) / Math.log(k))

  return `${(bytes / Math.pow(k, i)).toFixed(2)} ${sizes[i]}`
}

const sortedLinks = links.sort((a: any, b: any) => b.date - a.date)
---

<Layout>
  <div class="flex flex-col bg-white">
    <div class="m-2">
      {
        sortedLinks.map((data: Link) => (
          <div class="flex flex-col md:flex-row md:justify-between flex-1 min-w-0 md:min-w-[250px] border border-slate-400 rounded p-4 my-2 bg-white">
            <div>
              <p class="truncate">{data.filename}</p>
              <button
                class="mt-4 px-2 py-1 bg-blue-500 text-white rounded"
                onclick={`window.dispatchEvent(new CustomEvent("download-again", { detail: { link: "${data.link_dl}" } }))`}
              >
                Télécharger
              </button>
              <Tag tag={formatBytes(data.size)} />
            </div>
            <div>
              <p class="mt-2 text-sm text-gray-600">
                {moment.unix(data.date).format("DD/MM/YYYY à HH:mm")}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <DownloadAgainWrapper client:only="react" />
</Layout>
