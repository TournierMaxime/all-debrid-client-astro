---
import Layout from "@/layouts/Layout.astro"

import DownloadAgainWrapper from "@/wrappers/DownloadAgainWrapper"

import { allDebridService } from "@/services/za"

import DeleteSaveLinkWrapper from "@/wrappers/DeleteSaveLinkWrapper"

import { AlertMessage } from "@/components/Alert"
import HistoryTable from "@/feature/media/components/tables/HistoryTable.astro"

const response = await allDebridService.getUserLinks()
const { links } = response.data

const sortedLinks = links.sort((a: any, b: any) => b.date - a.date)

const description =
  "Les fichiers ici présents concernent uniquement les films ayant déjà été téléchargés.\nAfin de pouvoir les re-télécharger plus facilement via cette page, si les films ont été supprimés du NAS."
---

<Layout>
  <div class="flex flex-col bg-(--ads-bg-default)">
    <div class="m-2">
      <AlertMessage
        title="Historique de téléchargement"
        description={description}
      />
      <HistoryTable data={sortedLinks} />
    </div>
  </div>
  <DownloadAgainWrapper client:only="react" />
  <DeleteSaveLinkWrapper client:only="react" />
</Layout>
