---
import Layout from "../layouts/Layout.astro"
import Medias from "./medias.astro"

import { zaService } from "../services/za"

import Volume from "../feature/nas/Volume.astro"
import Announcement from "@/components/Announcement.astro"
import Loader from "@/components/Loader.astro"

const response = await zaService.getFilms()
const { films } = response

const annoucement = false
---

<Layout>
  {annoucement && <Announcement />}
  <Volume server:defer>
    <Loader slot="fallback" />
  </Volume>
  <Medias server:defer data={films}>
    <Loader slot="fallback" />
  </Medias>
</Layout>
