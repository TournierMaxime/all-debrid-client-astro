---
import Layout from "@/layouts/Layout.astro"
import Medias from "./medias.astro"

import { zaService } from "@/services/za"

import Volume from "@/feature/nas/Volume.astro"
import Announcement from "@/components/shared/Announcement.astro"
import Loader from "@/components/shared/Loader.astro"
import Skeleton from "@/components/shared/Skeleton.astro"

const getDomainName = await zaService.checkDomainName()

if (!getDomainName) return

const { name } = getDomainName.domain

const response = await zaService.getFilms()
const { films } = response

const annoucement = false
---

<Layout>
  {annoucement && <Announcement />}
  <Volume server:defer>
    <Loader slot="fallback" />
  </Volume>
  <Medias server:defer data={films} domainName={name}>
    <div
      slot="fallback"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 mx-auto"
    >
      {Array.from({ length: 4 }).map(() => <Skeleton />)}
    </div>
  </Medias>
</Layout>
