---
import Layout from "@/layouts/Layout.astro"

import DeleteTaskWrapper from "@/wrappers/DeleteTaskWrapper"
import { AlertMessage } from "@/components/shared/Alert"
import DownloadTable from "@/feature/media/components/tables/DownloadTable.astro"
import { gopeedService } from "@/services/gopeed"
// import { tasks } from "@/mocks/tasks"

const tasks = await gopeedService.getTasks()

if (!tasks) {
  return null
}
---

<Layout>
  <div class="bg-(--ads-bg-default) p-4">
    {
      tasks.data.length === 0 ? (
        <AlertMessage
          title="Aucun téléchargement en cours"
          description="Il n'y a actuellement aucun téléchargement en cours sur votre NAS."
        />
      ) : (
        <DownloadTable tasks={tasks} />
      )
    }
  </div>
  <DeleteTaskWrapper client:only="react" />
</Layout>
