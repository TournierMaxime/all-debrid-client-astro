---
import Layout from "../../../layouts/Layout.astro"

import type { Metadata as M } from "../../../types/metadata"
import { plexService } from "../../../services/plex"

import { plexEndpoint, plexToken } from "../../../constants/utils"

import { Image } from "astro:assets"

import Tag from "../../../components/Tag.astro"

import { formatDuration } from "../../../constants/utils"

const { id, ratingKey } = Astro.params

if (!id) return

const response = await plexService.getLibrary(id)
const { Metadata } = response.MediaContainer

const oneFilm: M = Metadata.find((m: M) => m.ratingKey === ratingKey)

const {
  title,
  summary,
  thumb,
  year,
  duration,
  Media,
  Genre,
  Collection,
  Country,
  Director,
  Writer,
  Role,
} = oneFilm

const path = Media.map((m) =>
  m.Part.map((p) => p.file.split("/").slice(0, -1).join("/")),
)
const file = Media.map((m) => m.Part.map((p) => p.file.split("/").pop()))

const videoResolution = Media.map((m) => m.videoResolution)
const videoFrameRate = Media.map((m) => m.videoFrameRate)
const audioCodec = Media.map((m) => m.audioCodec)
const videoCodec = Media.map((m) => m.videoCodec)
const extension = Media.map((m) => m.container)
---

<Layout>
  <div class="bg-white p-4">
    <div
      class="flex flex-col bg-slate-100 rounded-lg p-4 shadow-md border border-slate-400"
    >
      <div class="flex flex-col md:flex-row w-full">
        <div class="flex flex-col w-full md:w-4/12">
          <Image
            src={`${plexEndpoint}${thumb}?X-Plex-Token=${plexToken}`}
            alt={title}
            width={360}
            height={480}
            class="object-cover w-45 h-65 md:w-60 md:h-80 sm:w-40 sm:h-60 rounded-lg"
          />
        </div>
        <div class="flex flex-col md:w-7/12 w-full">
          <h1 class="font-semibold text-lg mt-4 md:mt-0 mb-2">
            {title}
          </h1>
          <p class="text-normal text-justify">{summary}</p>
        </div>
      </div>

      <div class="flex flex-col w-full mt-4">
        <h2 class="font-semibold text-lg">Fiche technique</h2>
        <h3 class="font-semibold text-normal ml-2">Realisation</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Director &&
              Director.map((d) => {
                return (
                  <li>
                    <Tag tag={d.tag} />
                  </li>
                )
              })
          }
        </ul>
        <h3 class="font-semibold text-normal ml-2">Scénario</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Writer &&
              Writer.map((w) => {
                return (
                  <li>
                    <Tag tag={w.tag} />
                  </li>
                )
              })
          }
        </ul>
        <h3 class="font-semibold text-normal ml-2">Distribution</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Role &&
              Role.map((r) => {
                return (
                  <li>
                    <Tag tag={r.tag} />
                  </li>
                )
              })
          }
        </ul>
        <h3 class="font-semibold text-normal ml-2">Durée</h3>
        <span class="ml-2">
          <Tag tag={formatDuration(duration)} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Année</h3>
        <span class="ml-2">
          <Tag tag={year} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Genre</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Genre &&
              Genre.map((g) => {
                return (
                  <li>
                    <Tag tag={g.tag} />
                  </li>
                )
              })
          }
        </ul>
        <h3 class="font-semibold text-normal ml-2">Pays</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Country &&
              Country.map((c) => {
                return (
                  <li>
                    <Tag tag={c.tag} />
                  </li>
                )
              })
          }
        </ul>
        <h3 class="font-semibold text-normal ml-2">Collection</h3>
        <ul class="ml-2 flex flex-row flex-wrap">
          {
            Collection ? (
              Collection.map((c) => {
                return (
                  <li>
                    <Tag tag={c.tag} />
                  </li>
                )
              })
            ) : (
              <span>Non</span>
            )
          }
        </ul>
      </div>

      <div class="flex flex-col w-full mt-4">
        <h2 class="font-semibold text-normal">Spécifications techniques</h2>
        <h3 class="font-semibold text-normal ml-2">Resolution</h3>
        <span class="ml-2">
          <Tag tag={videoResolution} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Image par seconde</h3>
        <span class="ml-2">
          <Tag tag={videoFrameRate} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Audio Codec</h3>
        <span class="ml-2">
          <Tag tag={audioCodec} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Video Codec</h3>
        <span class="ml-2">
          <Tag tag={videoCodec} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Extension du fichier</h3>
        <span class="ml-2">
          <Tag tag={extension} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Chemin</h3>
        <span class="ml-2">
          <Tag tag={path} />
        </span>
        <h3 class="font-semibold text-normal ml-2">Fichier</h3>
        <span class="ml-2">
          <Tag tag={file} />
        </span>
      </div>
    </div>
  </div>
</Layout>
