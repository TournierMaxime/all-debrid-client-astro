---
import Layout from "@/layouts/Layout.astro"
import RatingKeyComponent from "@/feature/media/components/RatingKey.astro"
import Skeleton from "@/components/Skeleton.astro"

const { ratingKey } = Astro.params

if (!ratingKey) return
---

<Layout>
  <RatingKeyComponent server:defer ratingKey={ratingKey}>
    <Skeleton slot="fallback" />
  </RatingKeyComponent>
</Layout>
