---
import Poster from "../feature/media/components/Poster.astro"
import { Card, CardContent, CardTitle } from "@/components/ui/card"

type Element = {
  title: string
  image: string
  link: string
}

type Props = {
  data: Element[]
}

const { data }: Props = Astro.props
---

<div class="flex flex-col bg-[var(--ads-bg-default)]">
  <ul
    class="grid
      grid-cols-2
      sm:grid-cols-3
      md:grid-cols-3
      lg:grid-cols-4
      mx-auto"
  >
    {
      data.map((film: Element) => {
        const { link, image, title } = film
        const splitUrl = link.split("?")
        const id = splitUrl[1]

        const splitUrlImg = image.split("/").slice(3).join("/")

        return (
          <Card className="m-2">
            <li>
              <a href={`/media/${id}`}>
                <Poster
                  clx="h-50 md:h-80 sm:h-60"
                  title={title}
                  src={`/${splitUrlImg}`}
                />
              </a>
              <CardTitle className="font-normal text-sm text-center mt-2 py-2">
                {title}
              </CardTitle>
            </li>
          </Card>
        )
      })
    }
  </ul>
</div>
