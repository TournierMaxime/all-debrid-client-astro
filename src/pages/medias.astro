---
import Poster from "../feature/media/components/Poster.astro"

type Element = {
  title: string
  image: string
  link: string
}

type Props = {
  data: Element[]
}

const { data }: Props = Astro.props
---

<div class="flex flex-col bg-white">
  <ul class="flex flex-row flex-wrap sm:items-center justify-between w-full">
    {
      data.map((film: Element) => {
        const splitUrl = film.link.split("?")
        const id = splitUrl[1]

        const splitUrlImg = film.image.split("/").slice(3).join("/")

        return (
          <li class="p-2">
            <a href={`/media/${id}`}>
              <Poster title={film.title} src={`/${splitUrlImg}`} />
            </a>
          </li>
        )
      })
    }
  </ul>
</div>
