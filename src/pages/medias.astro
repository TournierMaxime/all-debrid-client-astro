---
import Poster from "@/feature/media/components/Poster.astro"
import { Card, CardTitle } from "@/components/ui/card"
import { type Films } from "@/types/za"

interface Props {
  data: Films[]
  domainName: string
}

const { data, domainName }: Props = Astro.props
---

<div class="flex flex-col bg-(--ads-bg-default)">
  <ul
    class="grid
      grid-cols-2
      sm:grid-cols-3
      md:grid-cols-3
      lg:grid-cols-4
      mx-auto"
  >
    {
      data.map((film: Films) => {
        const { link, image, title } = film

        return (
          <Card className="m-2 cursor-pointer">
            <li>
              <a href={`/media/${link.split("?").slice(1).join("")}`}>
                <Poster
                  clx="h-50 md:h-80 sm:h-60"
                  title={title}
                  src={domainName + image}
                />
              </a>
              <CardTitle className="font-normal text-sm text-center mt-2 py-2">
                {title}
              </CardTitle>
            </li>
          </Card>
        )
      })
    }
  </ul>
</div>
