---
import Layout from "@/layouts/Layout.astro"

import { prowlarrService } from "@/services/prowlarr"

import moment from "moment"

import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import type { Search } from "@/types/prowlarr"
import Tag from "@/components/shared/Tag.astro"
import { Button } from "@/components/ui/button"
import {
  Pagination,
  PaginationContent,
  PaginationItem,
  PaginationNext,
  PaginationPrevious,
} from "@/components/ui/pagination"
import { Input } from "@/components/ui/input"

const url = new URL(Astro.request.url)
const LIMIT = 50
const OFFSET = Number(url.searchParams.get("offset")) || 0
const STEP = 50
const CATEGORIES = "2000"
const INDEXER_IDS = "1"
const TYPE = "search"
const QUERY = url.searchParams.get("query") || ""

const torrents = await prowlarrService.search({
  type: TYPE,
  categories: CATEGORIES,
  indexerIds: INDEXER_IDS,
  limit: LIMIT.toString(),
  offset: OFFSET.toString(),
  ...(QUERY && { query: QUERY }),
})

const hasNextPage = torrents.length === STEP
const currentPage = Math.floor(OFFSET / STEP) + 1

const queryParam = QUERY ? `&query=${encodeURIComponent(QUERY)}` : ""
---

<Layout>
  <div class="bg-(--ads-bg-default) p-4 rounded-none w-full">
    <div class={"flex flex-col w-full"}>
      <form
        method="get"
        action=""
        class="flex flex-col sm:flex-row sm:items-center"
      >
        <Input
          type="text"
          name="query"
          value={QUERY}
          placeholder={`Rechercher`}
          className="px-4 py-2 sm:w-8/12 w-full rounded-md border border-(--ads-form-border) text-(--ads-text-black) focus:outline-none"
        />
        <Button
          type="submit"
          className="flex w-full sm:w-4/12 mt-4 sm:mt-0 justify-center bg-(--ads-btn-default) px-4 py-2 rounded-md text-(--ads-text-default) transition cursor-pointer sm:ml-4"
        >
          Rechercher
        </Button>
      </form>
    </div>
    <Table className="bg-(--ads-bg-default) p-4 rounded-none">
      <TableHeader>
        <TableRow>
          <TableHead className="w-1/4">Titre</TableHead>
          <TableHead>Date</TableHead>
          <TableHead>Détails</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {
          torrents &&
            torrents.map((torrent: Search) => {
              const { title, publishDate, sortTitle } = torrent

              const displayTitle =
                title.length > 70 ? title.substring(0, 70) + "..." : title
              return (
                <TableRow>
                  <TableCell className="truncate">{displayTitle}</TableCell>
                  <TableCell>
                    <Tag
                      tag={moment(publishDate).format("DD/MM/YYYY à HH:mm")}
                    />
                  </TableCell>
                  <TableCell>
                    <Button
                      size={"sm"}
                      className="bg-(--ads-btn-default) rounded mr-4 cursor-pointer"
                    >
                      <a class="text-sm" href={`/torrent/${sortTitle}`}>
                        Consulter
                      </a>
                    </Button>
                  </TableCell>
                </TableRow>
              )
            })
        }
      </TableBody>
    </Table>
    <Pagination className="bg-(--ads-bg-default) p-4 rounded-none">
      <PaginationContent>
        {
          OFFSET > 0 && (
            <PaginationItem>
              <PaginationPrevious
                text="Précédent"
                href={`?categories=${CATEGORIES}&type=${TYPE}&indexerIds=${INDEXER_IDS}&limit=${LIMIT}&offset=${Math.max(0, OFFSET - STEP)}${queryParam}`}
              />
            </PaginationItem>
          )
        }

        <PaginationItem className="px-4 text-sm">
          Page {currentPage}
        </PaginationItem>

        {
          hasNextPage && (
            <PaginationItem>
              <PaginationNext
                text="Suivant"
                href={`?categories=${CATEGORIES}&type=${TYPE}&indexerIds=${INDEXER_IDS}&limit=${LIMIT}&offset=${OFFSET + STEP}${queryParam}`}
              />
            </PaginationItem>
          )
        }
      </PaginationContent>
    </Pagination>
  </div>
</Layout>
