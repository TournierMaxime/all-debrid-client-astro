---
import Loader from "@/components/Loader.astro"
import Layout from "@/layouts/Layout.astro"
import { DownloadTask } from "@/feature/media/components/DownloadTask"

const { id } = Astro.params

if (!id) return
---

<Layout>
  <div class="bg-(--ads-bg-default) p-4">
    <DownloadTask client:load taskId={id} server:defer>
      <Loader slot="fallback" />
    </DownloadTask>
  </div>
</Layout>
