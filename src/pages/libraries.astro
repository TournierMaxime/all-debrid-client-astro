---
import Layout from "../layouts/Layout.astro"

import { plexService } from "../services/plex"

import moment from "moment"

import Tag from "../components/Tag.astro"
import Button from "../components/Button"

interface UnifiedData {
  ratingKey: string
  title: string
  addedAt: number
  librarySectionID: number
  librarySectionTitle: string
}

const data = await plexService.getLibrary("1")

const sortMetadataFilms = data.sort(
  (a: UnifiedData, b: UnifiedData) => b.addedAt - a.addedAt,
)
---

<Layout>
  <div class="flex flex-col bg-white p-4">
    {
      sortMetadataFilms.map((m: UnifiedData) => {
        const { title, addedAt, librarySectionTitle, librarySectionID } = m

        return (
          <div class="w-full p-4 my-2 bg-white rounded-lg border border-slate-200 shadow-sm">
            <div class="flex flex-col-reverse sm:flex-row sm:justify-between">
              <h2>{title}</h2>

              <Tag tag={moment.unix(addedAt).format("DD/MM/YYYY à HH:mm")} />
            </div>
            <div class="flex flex-row justify-between items-baseline">
              <Tag tag={librarySectionTitle} />
              <Button title="Consulter">
                <a
                  class="text-sm"
                  href={`/library/${String(librarySectionID)}/${m.ratingKey}`}
                >
                  Consulter
                </a>
              </Button>
            </div>
          </div>
        )
      })
    }
  </div>
</Layout>
