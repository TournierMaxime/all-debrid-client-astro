---
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import moment from "moment"
import Button from "@/components/shared/Button.astro"
import { Button as BtnShadcn } from "@/components/ui/button"
import { formatBytes } from "@/lib/utils"
import type { Task } from "@/types/gopeed"
import Tag from "@/components/shared/Tag.astro"

const { tasks } = Astro.props

const statusStyles: Record<string, string> = {
  ready: "bg-slate-300",
  error: "bg-red-500 text-white",
  wait: "bg-orange-500 text-white",
  running: "bg-blue-700 text-white",
  pause: "bg-yellow-400",
  done: "bg-green-700 text-white",
}
---

<Table className="bg-(--ads-bg-default) p-4 rounded-none">
  <TableHeader>
    <TableRow>
      <TableHead>ID</TableHead>
      <TableHead>Titre</TableHead>
      <TableHead>Status</TableHead>
      <TableHead>Taille</TableHead>
      <TableHead>Création</TableHead>
      <TableHead>Détails</TableHead>
      <TableHead>Supprimer</TableHead>
    </TableRow>
  </TableHeader>
  <TableBody>
    {
      tasks.data.map((t: Task) => (
        <TableRow>
          <TableCell className="w-[14%]">{t.id}</TableCell>
          <TableCell className="w-[14%]">{t.name}</TableCell>
          <TableCell className="w-[14%]">
            <Tag
              tag={t.status}
              color={`border-none ${statusStyles[t.status]}`}
            />
          </TableCell>
          <TableCell className="w-[14%]">
            {formatBytes(t.meta.res.size)}
          </TableCell>
          <TableCell className="w-[14%]">
            {moment(t.createdAt).fromNow()}
          </TableCell>
          <TableCell className="w-[14%]">
            <BtnShadcn
              size={"sm"}
              className="bg-(--ads-btn-default) rounded mr-4 cursor-pointer"
              disabled={t.status === "done"}
            >
              <a class="text-sm" href={`/download/${t.id}`}>
                Consulter
              </a>
            </BtnShadcn>
          </TableCell>
          <TableCell className="w-[14%]">
            <Button
              isDeleteBtn={true}
              onclick={`window.dispatchEvent(new CustomEvent("delete-task", { detail: { id: ["${t.id}"] } }))`}
              title="Supprimer"
            />
          </TableCell>
        </TableRow>
      ))
    }
  </TableBody>
</Table>
