---
import DropDown from "@/components/shared/DropDown"

type Props = {
  qualities:
    | {
        quality: string
        url: string
      }[]
    | undefined
}

const { qualities } = Astro.props as Props

const getQualities = (url: string) => {
  return url.split("/?")[1] || ""
}
---

<DropDown
  client:load
  title="Qualités disponibles"
  label="Sélectionnez une qualité"
>
  <ul
    class="mt-2 bg-(--ads-bg-default) border border-(--ads-border-qualities) rounded-md shadow-md"
  >
    {
      qualities?.map((quality: { quality: string; url: string }) => (
        <li class="px-4 py-2 hover:bg-(--ads-hover-qualities) cursor-pointer">
          <a href={`/media/${getQualities(quality.url)}`}>
            <b class="p-2 font-normal text-sm">{quality.quality}</b>
          </a>
        </li>
      ))
    }
  </ul>
</DropDown>
