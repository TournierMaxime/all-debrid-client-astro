---
import DropDown from "../../../components/DropDown"

type Props = {
  languages:
    | {
        name: string
        url: string
      }[]
    | undefined
}

const { languages } = Astro.props as Props

const getLanguages = (url: string) => {
  return url.split("/?")[1] || ""
}
---

<DropDown
  client:load
  title="Langues disponibles"
  label="Sélectionnez une version"
>
  <ul class="mt-2 bg-white border border-gray-300 rounded-md shadow-md">
    {
      languages?.map((language) => (
        <li class="px-4 py-2 hover:bg-gray-200 cursor-pointer">
          <a href={`/media/${getLanguages(language.url)}`} class="p-2 m-2">
            <b>{language.name}</b>
          </a>
        </li>
      ))
    }
  </ul>
</DropDown>
