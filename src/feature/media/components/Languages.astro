---
import DropDown from "@/components/shared/DropDown"

type Props = {
  languages:
    | {
        name: string
        url: string
      }[]
    | undefined
}

const { languages } = Astro.props as Props
---

<DropDown
  client:load
  title="Langues disponibles"
  label="Sélectionnez une version"
>
  <ul
    class="mt-2 bg-(--ads-bg-default) border border-(--ads-border-languages) rounded-md shadow-md"
  >
    {
      languages?.map((language) => (
        <li class="px-4 py-2 hover:bg-(--ads-hover-languages) cursor-pointer">
          <a href={`/media/${language.url.split("?")[1]}`} class="p-2 m-2">
            <b>{language.name}</b>
          </a>
        </li>
      ))
    }
  </ul>
</DropDown>
