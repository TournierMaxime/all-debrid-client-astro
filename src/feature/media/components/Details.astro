---
import type { Media } from "../type/media"
interface Props {
  data: Media
}

const { data } = Astro.props

if (!data) {
  return null
}
---

<div class="flex flex-col w-full p-4 mb-4">
  <p class="my-2">
    <b>Titre:</b>
    {data.originalTitle ?? "Unknown title"}
  </p>
  {
    data.quality && (
      <p class="my-2">
        <b>Qualité:</b>
        {data.quality}
      </p>
    )
  }
  {
    data.description && (
      <p class="w-full text-justify my-2">
        <b>Synopsis:</b>
        {data.description}
      </p>
    )
  }
  {
    data.season && (
      <p class="my-2">
        <b>Saison:</b>
        {data.season}
      </p>
    )
  }
  {
    data.episodes && (
      <p class="my-2">
        <b>Episodes:</b>
        {data.episodes}
      </p>
    )
  }
  {
    data.directors && (
      <p class="my-2">
        <b>Réalisation:</b>
        {data.directors && data.directors.map((d: string) => d)}
      </p>
    )
  }
  {
    data.actors && (
      <p class="my-2">
        <b>Acteurs:</b>
        {data.actors && data.actors.map((a: string) => a)}
      </p>
    )
  }
  {
    data.origin && (
      <p class="my-2">
        <b>Origine:</b>
        {data.origin}
      </p>
    )
  }
  {
    data.releaseDate && (
      <p class="my-2">
        <b>Sortie:</b>
        {data.releaseDate}
      </p>
    )
  }
  {
    data.duration && (
      <p class="my-2">
        <b>Durée:</b>
        {data.duration}
      </p>
    )
  }
  {
    data.genres && (
      <p class="my-2">
        <b>Genres:</b>
        {data.genres && data.genres.map((g: string) => g)}
      </p>
    )
  }
  {
    data.fileName && (
      <p class="my-2 w-full text-justify">
        <b>Taille:</b>
        {data.fileName}
      </p>
    )
  }
</div>
