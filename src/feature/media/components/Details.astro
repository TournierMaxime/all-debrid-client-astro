---
import type { Actor } from "@/types/za"
import type { Media } from "../type/media"

import Tag from "@/components/shared/Tag.astro"

interface Props {
  data: Media
}

const { data } = Astro.props

if (!data) {
  return null
}
---

<div class="flex flex-col w-full md:pl-4 mb-4">
  {
    data.description && (
      <div class="w-full text-justify my-2 md:m-0">
        <h3 class="text-lg font-semibold">Synopsis</h3>
        <p class="flex flex-row flex-wrap">{data.description}</p>
      </div>
    )
  }
  {
    data.season && (
      <div class="my-2">
        <h3 class="text-lg font-semibold">Saison</h3>
        <Tag tag={data.season} />
      </div>
    )
  }
  {
    data.episodes && (
      <div class="my-2">
        <h3 class="text-lg font-semibold">Episodes</h3>
        <Tag tag={data.episodes} />
      </div>
    )
  }
  {
    data.directors && (
      <div class="flex flex-col my-2">
        <h3 class="text-lg font-semibold">Réalisation</h3>
        <div class="flex flex-row flex-wrap">
          {data.directors.map((director) => (
            <Tag tag={director.name} />
          ))}
        </div>
      </div>
    )
  }
  {
    data.actors && (
      <div class="flex flex-col">
        <h3 class="text-lg font-semibold">Acteurs</h3>
        <div class="flex flex-row flex-wrap">
          {data.actors.map((actor) => (
            <Tag tag={actor.name} />
          ))}
        </div>
      </div>
    )
  }
  {
    data.genres && (
      <div class="flex flex-col my-2">
        <h3 class="text-lg font-semibold">Genres</h3>
        <div class="flex flex-row flex-wrap">
          {data.genres.map((genre) => (
            <Tag tag={genre.name} />
          ))}
        </div>
      </div>
    )
  }
  {
    data.fileSize && (
      <div class="w-full text-justify">
        <h3 class="text-lg font-semibold">Taille</h3>
        <div class="flex flex-row flex-wrap">
          <Tag tag={data.fileSize} />
        </div>
      </div>
    )
  }
</div>
