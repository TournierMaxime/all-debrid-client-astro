---
import Details from "@/feature/media/components/Details.astro"
import Poster from "@/feature/media/components/Poster.astro"
import Qualities from "@/feature/media/components/Qualities.astro"
import Languages from "@/feature/media/components/Languages.astro"
import Tag from "@/components/Tag.astro"

import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"

import { zaService } from "@/services/za"

import { allDebridService } from "@/services/za"

import { EnumFilmSerie, type Media } from "@/feature/media/type/media"

import MediaWrapper from "@/wrappers/MediaWrapper"

import IsOnNas from "./IsOnNas.astro"

const { id } = Astro.props

const getDomainName = await zaService.getDomainName()

if (!getDomainName) throw new Error("No domain available")

const decodeURI = decodeURIComponent(id)
const url = `${getDomainName.domain}/?${decodeURI}`

let data: Media

if (id.includes("film")) {
  data = await zaService.getFilm(url)
} else if (id.includes("serie")) {
  data = await zaService.getSerie(url)
} else {
  throw new Error("Invalid ID parameter")
}

const {
  title,
  originalTitle,
  duration,
  origin,
  releaseDate,
  image,
  qualities,
  availableLanguages,
} = data

const normalizeTitle = data.title.split("[")[0].trim()

const [checkResult, secondCheckResult] = await Promise.all([
  allDebridService.check(normalizeTitle),
  allDebridService.check(originalTitle),
])

const isOnNAS = checkResult.isOnNAS || secondCheckResult.isOnNAS
---

<Card className="flex flex-col bg-(--ads-bg-default) rounded-none">
  <CardHeader>
    <CardTitle> {title}</CardTitle>
    <CardDescription>
      <ul class="flex flex-row flex-wrap my-2">
        <li><Tag tag={originalTitle} /></li>
        <li><Tag tag={duration} /></li>
        <li><Tag tag={origin} /></li>
        <li><Tag tag={releaseDate} /></li>
      </ul>
    </CardDescription>

    {/* Check if a film is on NAS */}
    <IsOnNas isOnNAS={isOnNAS} />
  </CardHeader>
  <CardContent className="flex flex-col items-center w-full h-full mx-auto">
    <div
      class="flex items-start md:flex-row md:justify-between flex-col w-full"
    >
      <Poster
        clx="w-45 h-65 md:w-60 md:h-80 sm:w-40 sm:h-60 rounded-lg"
        title={title}
        src={image}
      />
      <div class="flex flex-col w-full mb-4">
        <Details data={data} />
      </div>
    </div>

    {
      !isOnNAS && (
        <div class="flex md:flex-row md:justify-between flex-col w-full">
          {id.includes("film") ? (
            <Qualities qualities={qualities} />
          ) : (
            <Languages languages={availableLanguages} />
          )}

          <MediaWrapper
            client:load
            data={data}
            type={
              id.includes("film") ? EnumFilmSerie.film : EnumFilmSerie.serie
            }
          />
        </div>
      )
    }
  </CardContent>
</Card>
