---
import { Image as Img } from "astro:assets"

import Tag from "@/components/Tag.astro"
import Info from "@/components/Info.astro"
import Button from "@/components/Button.astro"
import Cast from "@/feature/media/components/Cast.astro"
import Rate from "@/feature/media/components/Rate.astro"
import Card from "@/components/Card.astro"

import { formatDuration, formatBytes } from "@/lib/utils"
import DeleteMetadataItemWrapper from "@/wrappers/DeleteMetadataItemWrapper"

import { AlertMessage } from "@/components/Alert"

import type { LibraryMetadata } from "@/types/metadata"
import { plexService } from "@/services/plex"

import { MoveFile, RenameFile } from "@/wrappers/FileStationWrapper"

const { ratingKey } = Astro.props

const response = await plexService.getLibraryMetadata(ratingKey)

if (response.Metadata.ratingKey !== ratingKey) return

const oneFilm: LibraryMetadata = response

const {
  Metadata,
  Media,
  Genre,
  Image,
  Part,
  Country,
  Director,
  Writer,
  Role,
  Rating,
  Producer,
} = oneFilm

const path = Part.file.split("/").slice(0, -1).join("/") ?? ""

const file = Part.file.split("/").pop() ?? ""

const size = Part.size ?? 0

const videoResolution = Media.videoResolution ?? ""

const videoFrameRate = Media.videoFrameRate ?? ""

const audioCodec = Media.audioCodec ?? ""

const videoCodec = Media.videoCodec ?? ""

const extension = Media.container ?? ""

const thumb = Image.find((i) => i.type === "coverPoster")

const posterUrl = `/api/plex/poster${thumb?.url}`

const criticRatings = Rating?.some((r) => r.type === "critic") ?? false

const audienceRatings = Rating?.some((r) => r.type === "audience") ?? false

const realPath = `${path.split("/volume1").slice(-1)[0]}/${file}`
const currentSection = path.split("/volume1").slice(-1)[0]
---

<div>
  <div class="bg-(--ads-bg-default) p-4">
    <div class="flex flex-col p-4">
      <div class="flex flex-col-reverse sm:flex-col md:flex-row w-full">
        <div class="flex flex-col md:w-8/12 w-full">
          <Card
            clx="h-[max-content]"
            title={Metadata.title}
            description={Metadata.summary}
          />
          {Director && <Cast title="Réalisation" data={Director} />}
          {Role && <Cast title="Distribution" data={Role} />}
          {Writer && <Cast title="Scénario" data={Writer} />}
          {Producer && <Cast title="Production" data={Producer} />}
          <Card title="Emplacement du fichier" clx="flex flex-col">
            <ul>
              <li class="py-2">
                <h6 class="font-semibold text-sm">Chemin</h6>
                <p class="text-sm truncate">{path}</p>
                <MoveFile currentSection={currentSection} />
              </li>
              <li class="py-2">
                <h6 class="font-semibold text-sm">Fichier</h6>
                <RenameFile
                  client:load
                  realPath={realPath}
                  file={file}
                  extension={extension}
                />
                <AlertMessage
                  clx="mt-4"
                  title="Renommer un fichier"
                  description="Lorsqu'un fichier est renommé celui peut prendre un instant avant d'être pris en compte à cause de la réindexation du fichier par Plex."
                />
              </li>
              <li class="py-2">
                <h6 class="font-semibold text-sm">Suppression de fichier</h6>
                <Button
                  isDeleteBtn={true}
                  onclick={`window.dispatchEvent(new CustomEvent("delete-metadata-item", { detail: { ids: "${ratingKey}" } }))`}
                  title="Supprimer"
                />
              </li>
            </ul>
          </Card>
        </div>
        <div class="md:w-1/12"></div>
        <div class="flex flex-col w-full md:w-3/12 rounded">
          <Img
            src={posterUrl}
            alt={Metadata.title}
            width={240}
            height={320}
            class="rounded-lg shadow-sm object-cover w-full h-full max-w-60 max-h-80 border border-(--ads-border) mb-4"
          />
          {
            criticRatings && (
              <Card title="Notes Presses">
                <Rate data={Rating} type="critic" />
              </Card>
            )
          }

          {
            audienceRatings && (
              <Card title="Notes Spectateurs">
                <Rate data={Rating} type="audience" />
              </Card>
            )
          }
          <Card title="Fiche technique">
            <Info title="Durée" data={formatDuration(Metadata.duration)} />
            <Info title="Année" data={Metadata.year} />
            <Info title="Genre" dataMap={Genre} />
            <Info title="Pays" dataMap={Country} />
          </Card>
          <Card title="Spécifications techniques">
            <h3 class="font-semibold text-sm">Taille du fichier</h3>
            <Tag tag={formatBytes(size)} />
            <h3 class="font-semibold text-sm">Resolution</h3>
            <Tag tag={videoResolution} />
            <h3 class="font-semibold text-sm">Image par seconde</h3>
            <Tag tag={videoFrameRate} />
            <h3 class="font-semibold text-sm">Audio Codec</h3>
            <Tag tag={audioCodec} />
            <h3 class="font-semibold text-sm">Video Codec</h3>
            <Tag tag={videoCodec} />
            <h3 class="font-semibold text-sm">Extension du fichier</h3>
            <Tag tag={extension} />
          </Card>
        </div>
      </div>
    </div>
  </div>
  <DeleteMetadataItemWrapper client:only="react" />
</div>
