---
import Info from "../../../components/Info.astro"
import type { Rating } from "../../../types/metadata"

interface Props {
  title: string
  data: Rating[]
  type: "critic" | "audience"
}

const { data, type, title } = Astro.props

if (!data) {
  return null
}

const filteredData = data?.filter((d) => d.type === type) ?? []
---

{filteredData.length > 0 && <h3 class="font-semibold text-normal">{title}</h3>}

{
  type === "critic" &&
    filteredData.map((d: Rating) => {
      const provider = d.image.split("://")[0]
      if (provider !== "rottentomatoes") return
      return <Info data={`RT ${d.value * 10}%`} />
    })
}

{
  type === "audience" &&
    filteredData.map((d: Rating) => {
      const provider = d.image.split("://")[0]
      switch (provider) {
        case "imdb":
          return <Info data={`IMDB ${d.value * 10}%`} />
        case "rottentomatoes":
          return <Info data={`RT ${d.value * 10}%`} />
        case "themoviedb":
          return <Info data={`TMDB ${d.value * 10}%`} />
      }
    })
}
