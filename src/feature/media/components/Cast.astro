---
import { Image } from "astro:assets"
import Tag from "../../../components/Tag.astro"

const { title, data } = Astro.props

interface Props<T> {
  title: string
  data: T[]
}

const hasDataMap = Array.isArray(data) && data.length > 0
---

<div
  class="flex flex-col flex-wrap h-[max-content] md:ml-4 rounded bg-white border border-slate-400 p-4 md:mb-0 mb-4 mt-4"
>
  <h1 class="font-semibold text-lg md:mt-0 mb-2">{title}</h1>

  <div class="flex flex-row flex-wrap">
    {
      hasDataMap &&
        data
          .map((d) => {
            if (!d.thumb) return null
            return (
              <div class="bg-white border border-slate-400 rounded p-2 m-2 max-w-[160px] shadow-md truncate">
                <Image
                  src={d.thumb}
                  class={"rounded-full"}
                  alt={d.tag}
                  width={160}
                  height={160}
                  decoding="async"
                  loading="lazy"
                />
                <h5 class="text-sm font-semibold mt-2">{d.tag}</h5>
              </div>
            )
          })
          .slice(0, 10)
    }
  </div>
</div>
