---
import { Image } from "astro:assets"
import Card from "@/components/shared/Card.astro"

const { title, data } = Astro.props

interface Props<T> {
  title: string
  data: T[]
}

const hasDataMap = Array.isArray(data) && data.length > 0
---

<Card title={title}>
  <div
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
  >
    {
      hasDataMap &&
        data
          .filter((d) => d.thumb)
          .slice(0, 10)
          .map((d) => {
            if (!d.thumb) return null
            return (
              <div class="group flex flex-col items-center rounded-lg border border-(--ads-border) bg-(--ads-bg-default) p-3 shadow-sm">
                <div class="relative">
                  <Image
                    src={d.thumb}
                    alt={d.tag}
                    width={120}
                    height={120}
                    class="rounded-full object-cover ring-2 ring-(--ads-img-cast) w-20 h-20"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <h5 class="mt-3 text-sm font-semibold text-(--ads-text-cast-h5) text-center line-clamp-2">
                  {d.tag}
                </h5>
              </div>
            )
          })
    }
  </div>
</Card>
