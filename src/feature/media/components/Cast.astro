---
import { Image } from "astro:assets"
import Card from "../../../components/Card.astro"

const { title, data } = Astro.props

interface Props<T> {
  title: string
  data: T[]
}

const hasDataMap = Array.isArray(data) && data.length > 0
---

<Card clx="h-fit p-4 md:ml-4 md:mb-0">
  <h1 class="font-semibold text-lg mb-4 text-slate-800">{title}</h1>

  <div
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
  >
    {
      hasDataMap &&
        data
          .filter((d) => d.thumb)
          .slice(0, 10)
          .map((d) => (
            <div class="group flex flex-col items-center rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
              <div class="relative">
                <Image
                  src={d.thumb}
                  alt={d.tag}
                  width={120}
                  height={120}
                  class="rounded-full object-cover ring-2 ring-slate-100 group-hover:ring-slate-300"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <h5 class="mt-3 text-sm font-semibold text-slate-700 text-center line-clamp-2">
                {d.tag}
              </h5>
            </div>
          ))
    }
  </div>
</Card>
