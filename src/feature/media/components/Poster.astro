---
import { Image } from "astro:assets"

const { title, src, clx } = Astro.props

if (!title || !src) {
  return null
}

console.log("src", src)
---

{
  (
    <Image
      src={src}
      alt={title ?? "Film title not provided"}
      width={360}
      height={480}
      class={`object-cover rounded-t-lg ${clx ?? null}`}
    />
  )
}
