---
import { Image } from "astro:assets"
import { zaFullUrl } from "../../../constants/utils"

const { title, src, clx } = Astro.props

if (!title || !src) {
  return null
}
---

<Image
  src={`${zaFullUrl + src}`}
  alt={title ?? "Film title not provided"}
  width={360}
  height={480}
  class={`object-cover rounded-t-lg ${clx ?? null}`}
  decoding="async"
  loading="lazy"
/>
