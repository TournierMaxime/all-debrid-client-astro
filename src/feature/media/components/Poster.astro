---
import { Image } from "astro:assets"
import { zaService } from "@/services/za"

const { title, src, alt, clx } = Astro.props

if (!title || !src) {
  return null
}

const getDomainName = await zaService.getDomainName()

if (!getDomainName) throw new Error("No domain available")
---

<Image
  src={`${getDomainName.domain + src}`}
  alt={title ?? "Film title not provided"}
  width={360}
  height={480}
  class={`object-cover rounded-t-lg ${clx ?? null}`}
/>
